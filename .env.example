# ==========================================
# Конфигурация PostgreSQL и pgvector
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=mysecretpassword
DB_NAME=medical_db

# ==========================================
# Конфигурация эмбеддингов
# ==========================================
# Допустимые провайдеры: fastembed, ollama, openai
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# ==========================================
# Конфигурация LLM (Qwen / Ollama / OpenAI)
# ==========================================
# Допустимые провайдеры: ollama, litellm, openai
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434


# Для OpenAI или совместимых сервисов (если используется)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ==========================================
# Пороги алгоритма сопоставления (Matching Engine)
# ==========================================
# >= 0.90: точный синоним (High confidence)
# 0.70 .. 0.90: вызов LLM-арбитра (Gray zone)
# < 0.70: абсолютно новый параметр
SIMILARITY_THRESHOLD_HIGH=0.90
SIMILARITY_THRESHOLD_LOW=0.70

# ==========================================
# Логирование
# ==========================================
LOG_LEVEL=INFO
