# Виртуальное окружение Python
.venv/
env/
venv/

# Кэш Python и тестов
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Данные PostgreSQL (сохраняются локально в папке проекта для легкого переноса)
# Если вы хотите передать проект целиком с базой данных через архив/флешку —
# просто скопируйте всю папку проекта вместе с postgres_data/.
# Для git бинарные файлы базы данных обычно игнорируются:
postgres_data/

# Логи и временные файлы
*.log
.coverage
htmlcov/
.idea/
.vscode/
