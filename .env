# ==========================================
# Конфигурация PostgreSQL и pgvector
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=mysecretpassword
DB_NAME=medical_db

# ==========================================
# Конфигурация эмбеддингов
# ==========================================
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# ==========================================
# Конфигурация LLM (Qwen через Ollama)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434


OPENAI_API_KEY=
OPENAI_BASE_URL=

# ==========================================
# Пороги алгоритма сопоставления
# ==========================================
SIMILARITY_THRESHOLD_HIGH=0.90
SIMILARITY_THRESHOLD_LOW=0.70

# ==========================================
# Логирование
# ==========================================
LOG_LEVEL=INFO
